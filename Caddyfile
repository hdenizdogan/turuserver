# =================================================
# TAILSCALE DOMAIN
# Manual TLS — TSDPROXY
# =================================================

# HTTP → HTTPS redirect for Tailscale domain
http://*.{$OLDDOMAIN} {
	redir https://{host}{uri} permanent
}


