# =================================================
# GLOBAL OPTIONS
# =================================================
{
	# Force Let's Encrypt PRODUCTION (log showed staging)
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}


# =================================================
# PUBLIC DOMAIN
# Cloudflare + Let's Encrypt (wildcard, DNS-01)
# =================================================

*.{$DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		# Bypass local AdGuard for ACME zone/TXT lookups (fixes SERVFAIL on com.)
		resolvers 1.1.1.1 8.8.8.8
	}

	# ---- SERVICES ----

	@adguard host adguard.{$DOMAIN}
	handle @adguard {
		reverse_proxy adguard:80
	}

	@bazarr host bazarr.{$DOMAIN}
	handle @bazarr {
		reverse_proxy bazarr:6767
	}

	@beszel host beszel.{$DOMAIN}
	handle @beszel {
		reverse_proxy beszel:8090
	}

	@cockpit host cockpit.{$DOMAIN}
	handle @cockpit {
		reverse_proxy 172.17.0.1:9090
	}

	@dash host dash.{$DOMAIN}
	handle @dash {
		reverse_proxy dash:3001
	}

	@feishin host feishin.{$DOMAIN}
